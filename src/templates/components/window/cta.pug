section.cta#cta.bg.bg-light.js-observe
    .container.block.default-grid
        .default-grid__header
            +headings('Skontaktuj się z nami', 'Masz pytania lub chcesz zamówić usługę?', 'Zadzwoń, napisz przez Messenger lub WhatsApp albo zostaw swój numer — oddzwonimy i ustalimy szczegóły.')
        .default-grid__body
            form.form.cta__form#cta-form(method="POST")
                input.input(type="text" placeholder="Imię" name="name", required)
                input.input(type="tel" placeholder="Telefon" name="phone", required)
                textarea.input.cta__input(placeholder="Wiadomość" name="message" rows="4")
                button.btn.btn-cta.btn-normal.cta__btn(type="submit") WYŚLIJ WIADOMOŚĆ
        .default-grid__footer
            +cta-button("Zadzwoń", "secondary")
            +cta-messengers()
