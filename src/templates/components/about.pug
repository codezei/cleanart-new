section.about#about.bg-light.js-observe
    .container.block.default-grid.custom-container
        .default-grid__header
            +headings('O nas', 'CleanArt — certyfikowana jakość i czystość bez kompromisów', '')
        .default-grid__body
            .row.row-cols-lg-2
                .col
                    picture
                        source(srcset="img/cert.webp" type="image/webp")
                        img.image(src="img/cert.png", alt="")
                .col
                    p Jesteśmy lokalną firmą z Wrocławia. Wykonujemy dokładne pranie tapicerki meblowej, w tym mebli skórzanych, materacy, dywanów i wykładzin oraz tapicerki samochodowej.
                    ul.list-check
                        //- li Certyfikat i sprzęt Kärcher
                        li Bezpieczna chemia (Eko/Pet)
                        li Darmowy dojazd
                        li Płatność po usłudze
        .default-grid__footer
            +cta-button()(class="btn-icon-tel")
            //- +cta-messengers()
