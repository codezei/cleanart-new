section.services#services.block.bg.bg-wave.js-observe
    .container.custom-container
        +headings('Usługi czyszczenia', 'Usługi prania i czyszczenia',  'Skuteczne pranie i czyszczenie tapicerki meblowej, materacy, dywanów i wykładzin oraz tapicerki samochodowej.')
        .swiper.services-swiper
            .swiper-wrapper
                .swiper-slide.col
                    .card.card-white.card-row
                        .card__header.text-center
                            .card__icon
                                picture
                                    source(srcset="img/service-furniture.webp", type="image/webp")
                                    img(src="img/service-furniture.png", alt="Tapicerki meblowa", width="110")
                        .card__body
                            h3.h5.card__title.text-uppercase ✦ Pranie tapicerki meblowej
                            ul.list-check
                                li Odświeżenie i usuwanie trudnych plam
                                li Neutralizacja brzydkich zapachów
                                li Czyszczenie mebli skórzanych
                                //- li Sofy, fotele, narożniki i krzesła
                        .card__footer
                            table
                                tr
                                    th Narożnik, Sofa, Wersalka
                                    th Fotel
                                    th Krzesło
                                tr
                                    td
                                        span.text-small od
                                        |&nbsp;
                                        span.text-accent.text-bold.h5 200
                                        |&nbsp;
                                        span.text-accent zl
                                    td
                                        span.text-small od
                                        |&nbsp;
                                        span.text-accent.text-bold.h5 70
                                        |&nbsp;
                                        span.text-accent zl
                                    td
                                        span.text-small od
                                        |&nbsp;
                                        span.text-accent.text-bold.h5 25
                                        |&nbsp;
                                        span.text-accent zl
                            hr
                            .card__row.justify-content-between
                                a.btn-link(href="./pranie-tapicerki-meblowej.html", target="_blank")
                                    span.btn-text Więcej o usłudze
                                +cta-button("", "cta")(class="btn-icon-tel")
                .swiper-slide.col
                    .card.card-white.card-row
                        .card__header.text-center
                            .card__icon
                                picture
                                    source(srcset="img/service-mattress.webp", type="image/webp")
                                    img(src="img/service-mattress.png", alt="Materac", width="110")
                        .card__body
                            h3.h5.card__title.text-uppercase ✦ Pranie materacy
                            ul.list-check
                                li Głębokie czyszczenie i dezynfekcja
                                li Usuwanie roztoczy, kurzu i alergenów
                                li Materace jedno- i dwuosobowe

                        .card__footer
                            table
                                tr
                                    th Materac jednoosobowy
                                    th Materac dwuosobowy
                                tr
                                    td
                                        span.text-small od
                                        |&nbsp;
                                        span.text-accent.text-bold.h5 180
                                        |&nbsp;
                                        span.text-accent zl
                                    td
                                        span.text-small od
                                        |&nbsp;
                                        span.text-accent.text-bold.h5 250
                                        |&nbsp;
                                        span.text-accent zl
                            hr
                            .card__row.justify-content-between
                                a.btn-link(href="./pranie-materacy.html", target="_blank") Więcej o usłudze
                                +cta-button("", "cta")(class="btn-icon-tel")
                .swiper-slide.col
                    .card.card-white.card-row
                        .card__header.text-center
                            .card__icon
                                picture
                                    source(srcset="img/service-carpet.webp", type="image/webp")
                                    img(src="img/service-carpet.png", alt="Dywan", width="110")
                        .card__body
                            h3.h5.card__title.text-uppercase ✦ Pranie dywanów
                            ul.list-check
                                li Usuwanie głębokiego brudu i sierści
                                li Przywrócenie puszystości i koloru
                                li Bezpieczne środki dla dzieci i zwierząt

                        .card__footer
                            table
                                tr
                                    th Dywan i wykładziny do 10 m²
                                tr
                                    td
                                        span.text-small od
                                        |&nbsp;
                                        span.text-accent.text-bold.h5 25
                                        |&nbsp;
                                        span.text-accent zl/m2
                            hr
                            .card__row.justify-content-between
                                a.btn-link(href="./pranie-dywanow.html", target="_blank") Więcej o usłudze
                                +cta-button("", "cta")(class="btn-icon-tel")
                .swiper-slide.col
                    .card.card-white.card-row
                        .card__header.text-center
                            .card__icon
                                picture
                                    source(srcset="img/service-salon.webp", type="image/webp")
                                    img(src="img/service-salon.png", alt="Tapicerki samochodowa", width="110")
                        .card__body
                            h3.h5.card__title.text-uppercase ✦ Pranie tapicerki samochodowej
                            ul.list-check
                                li Pranie foteli, boczków i podsufitki
                                li Usuwanie zacieków oraz plam
                                li Kompleksowe odświeżenie kabiny
                                //- li Bezpieczne środki dla dzieci i zwierząt

                        .card__footer
                            table
                                tr
                                    th Pełne pranie siedzeń
                                tr
                                    td
                                        span.text-small od
                                        |&nbsp;
                                        span.text-accent.text-bold.h5 250
                                        |&nbsp;
                                        span.text-accent zl
                            hr
                            .card__row.justify-content-between
                                a.btn-link(href="./pranie-tapicerki-samochodowej.html", target="_blank") Więcej o usłudze
                                +cta-button("", "cta")(class="btn-icon-tel")
                //- .categories-footer
                //- +cta-button("Zamów czyszczenie", "primary")(class="btn-icon-tel")
            +swiper-navigation()
