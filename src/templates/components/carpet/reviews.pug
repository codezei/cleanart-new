section.reviews.block#reviews.bg.bg-light.js-observe
    .container
        +headings('Opinie klientów', 'Co klienci mówią o praniu dywanów?', 'Poznaj doświadczenia klientów po wykonaniu usługi czyszczenia dywanów')
        .row.row-cols-sm-2.row-cols-lg-3.row-cols-xl-4
            each review, i in reviews.carpet
                +review(review.name, review.rating, review.date, review.text)(class="col animate-fade-in" style=`--i:${i};`)
        p.text-center
            +cta-button("Chcę taką samą jakość", "primary")(class="btn-icon-tel")
