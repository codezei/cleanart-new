section.faq#faq.bg.bg-wave.js-observe.block
    .container.custom-container.default-grid
        .default-grid__header
            +headings('FAQ', 'Najczęściej zadawane pytania', 'Sprawdź najważniejsze informacje dotyczące prania i czyszczenia oraz przygotowania do usługi')
        .default-grid__body
            .row
                each faq, i in faqs.salon
                    +faq(faq.question, faq.answer)(class="col animate-fade-in" style=`--i:${i};`)
        .default-grid__footer
            +cta-button()(class="btn-icon-tel")
            //- +cta-messengers()
