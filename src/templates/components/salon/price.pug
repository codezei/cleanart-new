section#price.price.bg-wave.js-observe.block
    .container.custom-container.default-grid
        .default-grid__header
            +headings('Cennik usług', 'Ile kosztuje pranie tapicerki samochodowej we Wrocławiu?', 'Sprawdź ceny prania tapicerki, siedzeń oraz kompleksowego czyszczenia wnętrza samochodu.')
        .default-grid__body
            .row.row-cols-sm-2.row-cols-xl-3
                each price, i in prices.salon
                    +price(price.name, price.value)(class="col animate-fade-in" style=`--i: ${i};`)
            p.text-small.text-italic
                span.d-ib * Ceny mogą się różnić w zależności od stopnia zabrudzenia. Minimalna kwota zamówienia z dojazdem do klienta: od 230 zł
        .default-grid__footer
            +cta-button()(class="btn-icon-tel")
            //- +cta-messengers()
