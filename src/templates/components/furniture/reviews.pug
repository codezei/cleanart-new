section.reviews.block#reviews.bg-light.js-observe
    .container.custom-container
        +headings('Opinie klientów', 'Co klienci mówią o praniu tapicerki?', 'Poznaj opinie osób, które zleciły nam czyszczenie kanap, narożników, foteli i innych mebli')
        .row.row-cols-sm-2.row-cols-lg-3.row-cols-xl-4
            each review, i in reviews.furniture
                +review(review.name, review.rating, review.date, review.text)(class="col animate-fade-in" style=`--i: ${i};`)
        p.text-center
            +cta-button("Chcę taką samą jakość", "primary")(class="btn-icon-tel")
