section.process#process-cleaning.block.bg-light.js-observe
    .container.custom-container
        +headings('Jak pracujemy', 'Jak wygląda czyszczenie?', 'Zobacz kolejne etapy realizacji usługi — od przygotowania do zakończenia pracy')
        +categories(['Tapicerka meblowa', 'Materace', 'Dywany', 'Tapicerka samochodowa'])
        .categories-content
            .swiper.categories-content-swiper(data-disallow-touch="true" data-auto-height="true")
                .swiper-wrapper
                    article.swiper-slide.h-auto
                        h3.categories-content__title Jak przebiega <span class="text-accent">pranie tapicerki meblowej</span>?
                        p.text-center Bezpieczny 6-etapowy proces przywracania świeżości kanapom i fotelom.
                        //- p Dobieramy sposób czyszczenia do rodzaju materiału i stopnia zabrudzenia.
                        .row.row-cols-lg-2.justify-content-center
                            .col
                                +slider('sofa', "Sofa przed rozpoczęciem czyszczenia tapicerki", "Sofa po profesjonalnym czyszczeniu tapicerki")
                        .row.row-cols-lg-2
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="1")
                                    .card__text <strong class="text-accent">Test tkaniny i dobór chemii</strong> — Ocena rodzaju materiału oraz wykonanie próby stabilności koloru. Dobieramy bezpieczne preparaty marek Chemspec, Global i Kiehl.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="2")
                                    .card__text <strong class="text-accent">Odkurzanie na sucho</strong> — Usuwanie kurzu, sierści i okruchów ze szczelin mebli za pomocą profesjonalnego odkurzacza Kärcher.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="3")
                                    .card__text <strong class="text-accent">Nałożenie pre-sprayu</strong> — Aplikacja środka wstępnego, który rozpuszcza głęboko wniknięty brud i tłuszcz.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="4")
                                    .card__text <strong class="text-accent">Odplamianie punktowe</strong> — Nanoszenie dedykowanych odplamiaczy na trudne plamy z wina, kawy czy jedzenia.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="5")
                                    .card__text <strong class="text-accent">Płukanie ekstrakcyjne</strong> — Wypłukiwanie brudnej wody i chemii pod ciśnieniem przy użyciu ekstraktora Santoemma / Profi.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="6")
                                    .card__text <strong class="text-accent">Neutralizacja pH i kontrola</strong> — Przywrócenie naturalnego pH tkaniny, dzięki czemu kanapa pozostaje miękka i dłużej czysta.

                    article.swiper-slide.h-auto
                        h3.categories-content__title Jak przebiega <span class="text-accent">czyszczenie i dezynfekcja materaca</span>?
                        p.text-center Skuteczne usuwanie roztoczy, plam biologicznych i zapachów.
                        //- p Stosujemy metodę czyszczenia dopasowaną do rodzaju i stanu materaca.
                        .row.row-cols-lg-2.justify-content-center
                            .col
                                +slider('mattress', "Materac wymagający dokładnego czyszczenia", "Materac po dokładnym praniu i odświeżeniu")
                        .row.row-cols-lg-2
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="1")
                                    .card__text <strong class="text-accent">Ocena stanu i głębokości zabrudzeń</strong> — Sprawdzenie struktury pokrowca i rodzaju plam (biologicznych, z potu czy moczu).
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="2")
                                    .card__text <strong class="text-accent">Głębokie odkurzanie antyalergiczne</strong> — Usuwanie martwego naskórka, kurzu i roztoczy z powierzchni materaca.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="3")
                                    .card__text <strong class="text-accent">Aplikacja pre-sprayu i enzymów</strong> — Nanoszenie preparatów rozkładających białka, tłuszcze i plamy organiczne.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="4")
                                    .card__text <strong class="text-accent">Neutralizacja nieprzyjemnych zapachów</strong> — Zastosowanie enzymatycznych neutralizatorów, które likwidują źródło zapachu, a nie tylko je maskują.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="5")
                                    .card__text <strong class="text-accent">Ekstrakcyjne wypłukiwanie brudu</strong> — Dogłębne odsysanie rozpuszczonych zanieczyszczeń i wilgoci ze struktury materaca.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="6")
                                    .card__text <strong class="text-accent">Dezynfekcja i suszenie</strong> — Antybakteryjne wykończenie powierzchni oraz opcjonalne wymuszone suszenie.

                    article.swiper-slide.h-auto
                        h3.categories-content__title Jak przebiega <span class="text-accent">pranie dywanów i wykładzin</span>?
                        p.text-center Głębokie czyszczenie runa z wyczesywaniem sierści i piasku.
                        //- p Metodę prania dobieramy do rodzaju włókien, runa i stopnia zabrudzenia.
                        .row.row-cols-lg-2.justify-content-center
                            .col
                                +slider('carpet', "Dywan przed rozpoczęciem prania", "Dywan po profesjonalnym czyszczeniu")
                        .row.row-cols-lg-2
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="1")
                                    .card__text <strong class="text-accent">Identyfikacja włókna</strong> — Określenie typu dywanu (wełna, syntetyk, shaggy) w celu doboru bezpiecznego ciśnienia i temperatury.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="2")
                                    .card__text <strong class="text-accent">Trzepanie i odkurzanie mechaniczne</strong> — Usuwanie piasku, żwiru i suchego brudu tkwiącego u nasady runa.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="3")
                                    .card__text <strong class="text-accent">Rozczesywanie i wyczesywanie sierści</strong> — Mechaniczne usuwanie wplątanej sierści zwierząt i włosów specjalnymi szczotkami.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="4")
                                    .card__text <strong class="text-accent">Nałożenie chemii czyszczącej</strong> — Rozpuszczanie brudu wewnątrz włókien za pomocą bezpiecznego pre-sprayu.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="5")
                                    .card__text <strong class="text-accent">Płukanie pod ciśnieniem (Ekstrakcja)</strong> — Wypłukiwanie brudu z całej grubości dywanu bez ryzyka przemoczenia spodu.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="6")
                                    .card__text <strong class="text-accent">Ułożenie runa i kontrola efektu</strong> — Czesanie włókien w jednym kierunku dla idealnego wyglądu po wyschnięciu.

                    article.swiper-slide.h-auto
                        h3.categories-content__title Jak przebiega <span class="text-accent">pranie tapicerki samochodowej</span>?
                        p.text-center Kompleksowe czyszczenie foteli, podsufitki i wnętrza auta.
                        //- p Usuwamy zabrudzenia i zapachy, dobierając metodę do rodzaju materiału.
                        .row.row-cols-lg-2.justify-content-center
                            .col
                                +slider('salon', "Tapicerka samochodowa przed czyszczeniem", "Tapicerka samochodowa po dokładnym praniu i odświeżeniu")
                        .row.row-cols-lg-2
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="1")
                                    .card__text <strong class="text-accent">Inspekcja wnętrza pojazdu</strong> — Ocena stanu foteli, boczków, podłogi oraz dobór metod czyszczenia.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="2")
                                    .card__text <strong class="text-accent">Dokładne odkurzanie i wydmuchiwanie</strong> — Usuwanie piasku i brudu z trudno dostępnych zakamarków, prowadnic i szczelin.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="3")
                                    .card__text <strong class="text-accent">Pre-spray i czyszczenie pędzelkami</strong> — Rozpuszczanie brudu na fotelach oraz delikatne czyszczenie plastików i detali.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="4")
                                    .card__text <strong class="text-accent">Usuwanie trudnych plam i zapachów</strong> — Czyszczenie punktowe plam oraz neutralizacja zapachu dymu papierosowego czy wilgoci.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="5")
                                    .card__text <strong class="text-accent">Ekstrakcja foteli i podłogi</strong> — Wypłukiwanie zanieczyszczeń z materiału przy użyciu profesjonalnego ekstraktora.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="6")
                                    .card__text <strong class="text-accent">Pełne suszenie wnętrza</strong> — Suszenie auta, dzięki czemu pojazd jest gotowy do jazdy natychmiast po usłudze.

                .categories-content-navigation
                    //- +cta-button()
                    +swiper-navigation()
        .categories-footer
            +cta-button("Zamów czyszczenie", "secondary")(class="btn-icon-tel")
