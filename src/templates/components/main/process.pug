section.process#process-cleaning.block.bg-light.js-observe
    .container.custom-container
        +headings('Jak pracujemy', 'Jak wygląda czyszczenie?', 'Zobacz kolejne etapy realizacji usługi — od przygotowania do zakończenia pracy')
        +categories(['Tapicerka meblowa', 'Materace', 'Dywany', 'Tapicerka samochodowa'])
        .categories-content
            .swiper.categories-content-swiper(data-disallow-touch="true" data-auto-height="true")
                .swiper-wrapper
                    article.swiper-slide.h-auto
                        h3.categories-content__title Jak przebiega <span class="text-accent">pranie tapicerki meblowej</span>?
                        p.text-center Bezpieczny 6-etapowy proces przywracania świeżości kanapom i fotelom.
                        //- p Dobieramy sposób czyszczenia do rodzaju materiału i stopnia zabrudzenia.
                        .row.row-cols-lg-2.justify-content-center
                            .col
                                +slider('sofa', "Sofa przed rozpoczęciem czyszczenia tapicerki", "Sofa po profesjonalnym czyszczeniu tapicerki")
                        .row.row-cols-lg-2
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="1")
                                    .card__text <strong class="text-accent">Ocena materiału i dobór chemii</strong> — Sprawdzamy rodzaj materiału i dobieramy odpowiednie środki.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="2")
                                    .card__text <strong class="text-accent">Odkurzanie na sucho</strong> — Usuwamy kurz, sierść i okruchy ze szczelin mebla za pomocą profesjonalnego odkurzacza.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="3")
                                    .card__text <strong class="text-accent">Odplamianie punktowe</strong> — Usuwamy trudne plamy przed właściwym praniem.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="4")
                                    .card__text <strong class="text-accent">Pre-spray</strong> — Nakładamy środek, który przygotowuje zabrudzenia do prania.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="5")
                                    .card__text <strong class="text-accent">Płukanie ekstrakcyjne</strong> — Wypłukujemy rozpuszczony brud za pomocą ekstraktora Santoemma.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="6")
                                    .card__text <strong class="text-accent">Kontrola efektu</strong> — Sprawdzamy dokładność wykonanej usługi.
                    article.swiper-slide.h-auto
                        h3.categories-content__title Jak przebiega <span class="text-accent">czyszczenie i dezynfekcja materaca</span>?
                        p.text-center Skuteczne usuwanie roztoczy, plam biologicznych i zapachów.
                        //- p Stosujemy metodę czyszczenia dopasowaną do rodzaju i stanu materaca.
                        .row.row-cols-lg-2.justify-content-center
                            .col
                                +slider('mattress', "Materac wymagający dokładnego czyszczenia", "Materac po dokładnym praniu i odświeżeniu")
                        .row.row-cols-lg-2
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="1")
                                    .card__text <strong class="text-accent">Ocena materaca</strong> — Sprawdzamy stan materaca i rodzaj zabrudzeń.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="2")
                                    .card__text <strong class="text-accent">Odkurzanie</strong> — Usuwamy kurz, naskórek i inne suche zabrudzenia.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="3")
                                    .card__text <strong class="text-accent">Odplamianie i pre-spray</strong> — Przygotowujemy zabrudzenia do właściwego prania.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="4")
                                    .card__text <strong class="text-accent">Neutralizacja zapachów</strong> — Stosujemy odpowiednie środki na nieprzyjemne zapachy.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="5")
                                    .card__text <strong class="text-accent">Płukanie ekstrakcyjne</strong> — Wypłukujemy rozpuszczone zabrudzenia z materaca.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="6")
                                    .card__text <strong class="text-accent">Suszenie i kontrola</strong> — Sprawdzamy efekt i w razie potrzeby wykonujemy dodatkowe suszenie.
                    article.swiper-slide.h-auto
                        h3.categories-content__title Jak przebiega <span class="text-accent">pranie dywanów i wykładzin</span>?
                        p.text-center Głębokie czyszczenie runa z wyczesywaniem sierści i piasku.
                        //- p Metodę prania dobieramy do rodzaju włókien, runa i stopnia zabrudzenia.
                        .row.row-cols-lg-2.justify-content-center
                            .col
                                +slider('carpet', "Dywan przed rozpoczęciem prania", "Dywan po profesjonalnym czyszczeniu")
                        .row.row-cols-lg-2
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="1")
                                    .card__text <strong class="text-accent">Odkurzanie na sucho</strong> — Usuwamy kurz, piasek, sierść i suche zabrudzenia.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="2")
                                    .card__text <strong class="text-accent">Odplamianie</strong> — Usuwamy trudne plamy przed właściwym praniem.

                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="3")
                                    .card__text <strong class="text-accent">Pre-spray i czyszczenie szczotką</strong> — Nakładamy środek czyszczący i dokładnie pracujemy szczotką w zabrudzonych miejscach.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="4")
                                    .card__text <strong class="text-accent">Płukanie ekstrakcyjne</strong> — Wypłukujemy rozpuszczony brud za pomocą profesjonalnego ekstraktora Santoemma.
                    article.swiper-slide.h-auto
                        h3.categories-content__title Jak przebiega <span class="text-accent">pranie tapicerki samochodowej</span>?
                        p.text-center Kompleksowe czyszczenie foteli, podsufitki i wnętrza auta.
                        //- p Usuwamy zabrudzenia i zapachy, dobierając metodę do rodzaju materiału.
                        .row.row-cols-lg-2.justify-content-center
                            .col
                                +slider('salon', "Tapicerka samochodowa przed czyszczeniem", "Tapicerka samochodowa po dokładnym praniu i odświeżeniu")
                        .row.row-cols-lg-2
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="1")
                                    .card__text <strong class="text-accent">Ocena wnętrza</strong> — Sprawdzamy stan tapicerki i rodzaj zabrudzeń.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="2")
                                    .card__text <strong class="text-accent">Odkurzanie</strong> — Usuwamy kurz, piasek i suche zabrudzenia z całego wnętrza.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="3")
                                    .card__text <strong class="text-accent">Odplamianie i pre-spray</strong> — Przygotowujemy zabrudzenia do właściwego czyszczenia.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="4")
                                    .card__text <strong class="text-accent">Czyszczenie szczotką</strong> — Pracujemy nad zabrudzeniami na tapicerce i trudno dostępnych miejscach.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="5")
                                    .card__text <strong class="text-accent">Płukanie ekstrakcyjne</strong> — Wypłukujemy rozpuszczone zabrudzenia za pomocą profesjonalnego ekstraktora.
                            .col.card.card-white
                                .card__header.card__row.align-items-start
                                    .card__icon(data-number="6")
                                    .card__text <strong class="text-accent">Suszenie i kontrola</strong> — Sprawdzamy efekt końcowy i wykonujemy dodatkowe suszenie w razie potrzeby.
                .categories-content-navigation
                    //- +cta-button()
                    +swiper-navigation()
        .categories-footer
            +cta-button("Zamów czyszczenie", "primary")(class="btn-icon-tel")
