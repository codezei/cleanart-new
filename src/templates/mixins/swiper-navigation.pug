mixin  swiper-navigation()
    .swiper-navigation
        button.swiper-navigation-button.swiper-navigation-button-prev.btn.btn-white.btn-normal.btn-icon-arrow-left(type="button")
            span.sr-only
        button.swiper-navigation-button.swiper-navigation-button-next.btn.btn-white.btn-normal.btn-icon-arrow-right(type="button")
            span.sr-only
        .swiper-pagination
