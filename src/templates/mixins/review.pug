mixin review(name, rating, date, text)
    .card.card-column.card-white&attributes(attributes)
        .card__header
            .text-bold.h6.card__title.mb-0= name
            .card__text
                .rating(style=`--star-rating: ${rating};`)
        .card__body
            //- .card__text.text-muted= date
            p.card__text= text
