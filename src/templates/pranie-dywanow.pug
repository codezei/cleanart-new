extends settings/layout

prepend html
    - const lang = "pl";

prepend head
    - const pageTitle = "Pranie dywanów i wykładzin Wrocław | CleanArt"
    - const pageDescription = "Pranie dywanów i wykładzin we Wrocławiu z dojazdem do klienta. Usuwamy plamy, sierść, kurz i zabrudzenia, dobierając metodę czyszczenia do rodzaju włókien."
    - const pageKeywords = ""
    - const pageUrl = "pranie-dywanow.html"
    - const pageImage = "img/carpet/carpet-img-1.webp"
    - const twitterImage = "img/carpet/carpet-img-1.webp"
    - const themeColor = "#ffffff"

append head
    meta(name="robots" content="index, follow")
    link(rel="preload" as="image" href="img/carpet-2-before-mob.webp" type="image/webp" media="(max-width: 430px)" fetchpriority="high")
    link(rel="preload" as="image" href="img/carpet-2-after-mob.webp" type="image/webp" media="(max-width: 430px)" fetchpriority="high")
    link(rel="preload" href="fonts/montserrat-v31-latin-ext-300.woff2" as="font" type="font/woff2" crossorigin)
    link(rel="preload" href="fonts/montserrat-v31-latin-ext-700.woff2" as="font" type="font/woff2" crossorigin)
    include components/carpet/schema


append content
    include mixins/cta-button
    include mixins/cta-messengers
    include mixins/swiper-navigation
    include mixins/schedule
    include mixins/faq
    include mixins/review
    include mixins/cities
    include mixins/gallery
    include mixins/categories
    include mixins/headings
    include mixins/price
    include mixins/slider

    include data/prices
    include data/reviews
    include data/faqs
    include data/works
    include components/header
    main
        include components/carpet/promo
        include components/carpet/price
        include components/carpet/process
        include components/carpet/reviews
        include components/carpet/works
        include components/carpet/cta
        include components/carpet/faq
        include components/contacts

        include components/popup
        include components/icons
    include components/footer

append scripts
